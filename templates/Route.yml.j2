---
# Intelligent Route validation - auto-discovers routes and tests HTTP accessibility
- name: "[{{ _login.cluster.name |d('Cluster')}}][Route] Discovering routes in {{ _validate.namespace | default('all namespaces') }}"
  ignore_errors: true
  k8s_info:
    {% raw %}
    host: "{{ (_r_auth_cluster.k8s_auth.host | default('')) if _r_auth_cluster is defined else omit }}"
    username: "{{ (_r_auth_cluster.k8s_auth.username | default('')) if _r_auth_cluster is defined else omit }}"
    api_key: "{{ (_r_auth_cluster.k8s_auth.api_key | default('')) if _r_auth_cluster is defined else omit }}"
    {% endraw -%}
    validate_certs: false
    kind: Route
{% if _validate.name is defined %}
    name: "{{ _validate.name }}"
{% endif %}
{% if _validate.namespace is defined %}
    namespace: "{{ _validate.namespace }}"
{% endif %}
  register: _r_validate_universal
  retries: "{{ _validate.retries | default(30) }}"
  delay: "{{ _validate.delay | default(5) }}"

# Debug output to see what we actually got
- name: "Debug - Show route discovery results"
  debug:
    msg: |
      Route discovery results for namespace {{ _validate.namespace | default('all') }}:
      - Failed: {{ _r_validate_universal.failed | default(false) }}
      - Resources found: {{ _r_validate_universal.resources | default([]) | length }}
      - Resource kinds: {{ _r_validate_universal.resources | default([]) | map(attribute='kind') | list if _r_validate_universal.resources is defined else 'None' }}
      - Resource names: {{ _r_validate_universal.resources | default([]) | map(attribute='metadata.name') | list if _r_validate_universal.resources is defined else 'None' }}

- name: "Success - routes found"
  when: 
    - not _r_validate_universal.failed | bool
    - _r_validate_universal.resources | default([]) | length > 0
  set_fact:
    success: true

- name: "No Success - no routes found"
  when: 
    - _r_validate_universal.failed | bool or (_r_validate_universal.resources | default([]) | length == 0)
  set_fact:
    success: false

- name: "set log message"
  set_fact:
    log_message: "{{ _validate.name | default('Routes') }} discovery in {{ _validate.namespace | default('cluster') }}"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
- name: "Route discovery result"
  debug:
    msg: {% raw %}"[ {{ log_message }} : {%if success%}PASS{%else%}FAIL{%endif%} ]"{% endraw %}
{% else %}
- name: "Route discovery result"
  assert:
    that: not _r_validate_universal.failed | bool
    {% raw %}
    fail_msg: "[ {{ log_message }} : FAIL ]"
    success_msg: "[ {{ log_message }} : PASS ]"
    {% endraw %}
{% endif %}

# Test HTTP accessibility for discovered routes (only if they are actually Routes)
- name: "[{{ _login.cluster.name |d('Cluster')}}][Route] Testing HTTP accessibility"
  when: 
    - not _r_validate_universal.failed | bool
    - _r_validate_universal.resources | default([]) | length > 0
    - _r_validate_universal.resources | default([]) | selectattr('kind', 'equalto', 'Route') | list | length > 0
  ignore_errors: true
  uri:
    {% raw %}
    url: "{{ item.spec.tls is defined | ternary('https', 'http') }}://{{ item.spec.host }}"
    {% endraw -%}
    method: GET
    return_content: false
    validate_certs: false
    status_code: "{{ _validate.status_code | default([200, 302, 301, 403]) }}"
    timeout: 30
  register: _r_validate_route_http
  loop: "{{ _r_validate_universal.resources | default([]) | selectattr('kind', 'equalto', 'Route') | list }}"
  retries: "{{ _validate.retries | default(5) }}"
  delay: "{{ _validate.delay | default(10) }}"

- name: "Route HTTP accessibility result"
  when: 
    - _r_validate_route_http is defined 
    - not _r_validate_route_http.skipped | default(false)
    - _r_validate_route_http.results is defined
  block:
    - name: "Success - HTTP accessible"
      when: _r_validate_route_http.results | selectattr('failed', 'equalto', false) | list | length > 0
      set_fact:
        success: true

    - name: "No Success - HTTP not accessible"
      when: _r_validate_route_http.results | selectattr('failed', 'equalto', true) | list | length == (_r_validate_route_http.results | length)
      set_fact:
        success: false

    - name: "set log message"
      set_fact:
        log_message: "HTTP accessibility test for routes in {{ _validate.namespace | default('cluster') }}"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
    - name: "Route HTTP accessibility result"
      debug:
        msg: {% raw %}"[ {{ log_message }} : {%if success%}PASS{%else%}FAIL{%endif%} ]"{% endraw %}
{% else %}
    - name: "Route HTTP accessibility result"
      assert:
        that: success | default(false) | bool
        {% raw %}
        fail_msg: "[ {{ log_message }} : FAIL ]"
        success_msg: "[ {{ log_message }} : PASS ]"
        {% endraw %}
{% endif %}