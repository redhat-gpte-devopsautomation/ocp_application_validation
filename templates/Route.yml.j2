---
# Intelligent Route validation - auto-discovers routes and tests HTTP accessibility
- name: "[{{ _login.cluster.name |d('Cluster')}}][Route] Discovering routes in {{ _validate.namespace | default('all namespaces') }}"
  ignore_errors: true
  kubernetes.core.k8s_info:
    api_version: route.openshift.io/v1
    kind: Route
{% if _validate.name is defined %}
    name: "{{ _validate.name }}"
{% endif %}
{% if _validate.namespace is defined %}
    namespace: "{{ _validate.namespace }}"
{% endif %}
  register: _r_validate_universal
  retries: "{{ _validate.retries | default(30) }}"
  delay: "{{ _validate.delay | default(5) }}"

# Debug output to see what we actually got
- name: "Debug - Show route discovery and HTTP test results"
  debug:
    msg: |
      Route validation results for namespace {{ _validate.namespace | default('all') }}:
      - Failed: {{ _r_validate_universal.failed | default(false) }}
      - Resources found: {{ _r_validate_universal.resources | default([]) | length }}
      - Resource names: {{ _r_validate_universal.resources | default([]) | map(attribute='metadata.name') | list if _r_validate_universal.resources is defined else 'None' }}
      {% if _r_route_http_tests is defined and not _r_route_http_tests.skipped | default(false) %}
      - HTTP Tests Performed: {{ '{{' }} _r_route_http_tests.results | default([]) | length {{ '}}' }}
      - HTTP Successful: {{ '{{' }} _http_success_count | default(0) {{ '}}' }} / {{ '{{' }} _r_validate_universal.resources | default([]) | length {{ '}}' }}
      {% endif %}

- name: "Success - routes found"
  when: 
    - not _r_validate_universal.failed | bool
    - _r_validate_universal.resources | default([]) | length > 0
  set_fact:
    success: true

- name: "No Success - no routes found"
  when: 
    - _r_validate_universal.failed | bool or (_r_validate_universal.resources | default([]) | length == 0)
  set_fact:
    success: false

- name: "set log message"
  set_fact:
    log_message: "{{ _validate.name | default('Routes') }} discovery and HTTP connectivity validation in {{ _validate.namespace | default('cluster') }}"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
- name: "Route discovery result"
  debug:
    msg: "[ {{ '{{' }} log_message {{ '}}' }} : {% if success %}PASS{% else %}FAIL{% endif %} ]"
{% else %}
- name: "Route discovery result"
  assert:
    that: not _r_validate_universal.failed | bool
    fail_msg: "[ {{ '{{' }} log_message {{ '}}' }} : FAIL ]"
    success_msg: "[ {{ '{{' }} log_message {{ '}}' }} : PASS ]"
{% endif %}

- name: "Test HTTP connectivity to routes"
  when: 
    - not _r_validate_universal.failed | bool
    - _r_validate_universal.resources | default([]) | length > 0
  uri:
    url: "{{ '{{' }} (item.spec.tls is defined) | ternary('https', 'http') {{ '}}' }}://{{ '{{' }} item.spec.host {{ '}}' }}"
    method: GET
    return_content: false
    validate_certs: false
{% if _validate.status_code is defined %}
{% if _validate.status_code | length > 0 %}
    status_code: "{{ '{{' }} _validate.status_code {{ '}}' }}"
{% else %}
    # Empty status_code: [] means accept any status code
    status_code: [200, 201, 202, 300, 301, 302, 303, 304, 400, 401, 403, 404, 500, 502, 503]
{% endif %}
{% else %}
    # Default: only success status codes
    status_code: [200, 302, 301]
{% endif %}
    timeout: 30
  register: _r_route_http_tests
  ignore_errors: true
  loop: "{{ '{{' }} _r_validate_universal.resources | default([]) {{ '}}' }}"
  retries: "{{ _validate.retries | default(3) }}"
  delay: "{{ _validate.delay | default(10) }}"

- name: "Count successful HTTP responses"
  when: 
    - _r_route_http_tests is defined
    - not _r_route_http_tests.skipped | default(false)
    - _r_route_http_tests.results is defined
  set_fact:
    _http_success_count: "{{ '{{' }} _r_route_http_tests.results | selectattr('failed', 'equalto', false) | list | length {{ '}}' }}"

- name: "Update success based on HTTP results"
  when: 
    - not _r_validate_universal.failed | bool
    - _r_validate_universal.resources | default([]) | length > 0
    - _http_success_count is defined
  set_fact:
    success: "{{ '{{' }} (_http_success_count | int) == (_r_validate_universal.resources | length) {{ '}}' }}"

