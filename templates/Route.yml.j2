---
# Intelligent Route validation - auto-discovers routes and tests HTTP accessibility
- name: "[{{ _login.cluster.name |d('Cluster')}}][Route] Discovering routes in {{ _validate.namespace | default('all namespaces') }}"
  ignore_errors: true
  kubernetes.core.k8s_info:
    api_version: route.openshift.io/v1
    kind: Route
{% if _validate.name is defined %}
    name: "{{ _validate.name }}"
{% endif %}
{% if _validate.namespace is defined %}
    namespace: "{{ _validate.namespace }}"
{% endif %}
  register: _r_validate_universal
  retries: "{{ _validate.retries | default(30) }}"
  delay: "{{ _validate.delay | default(5) }}"

# Debug output to see what we actually got
- name: "Debug - Show route discovery results"
  debug:
    msg: |
      Route discovery results for namespace {{ _validate.namespace | default('all') }}:
      - Failed: {{ _r_validate_universal.failed | default(false) }}
      - Resources found: {{ _r_validate_universal.resources | default([]) | length }}
      - Resource kinds: {{ _r_validate_universal.resources | default([]) | map(attribute='kind') | list if _r_validate_universal.resources is defined else 'None' }}
      - Resource names: {{ _r_validate_universal.resources | default([]) | map(attribute='metadata.name') | list if _r_validate_universal.resources is defined else 'None' }}

- name: "Success - routes found"
  when: 
    - not _r_validate_universal.failed | bool
    - _r_validate_universal.resources | default([]) | length > 0
  set_fact:
    success: true

- name: "No Success - no routes found"
  when: 
    - _r_validate_universal.failed | bool or (_r_validate_universal.resources | default([]) | length == 0)
  set_fact:
    success: false

- name: "set log message"
  set_fact:
    log_message: "{{ _validate.name | default('Routes') }} discovery in {{ _validate.namespace | default('cluster') }}"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
- name: "Route discovery result"
  debug:
    msg: "[ {{ '{{' }} log_message {{ '}}' }} : {% if success %}PASS{% else %}FAIL{% endif %} ]"
{% else %}
- name: "Route discovery result"
  assert:
    that: not _r_validate_universal.failed | bool
    fail_msg: "[ {{ '{{' }} log_message {{ '}}' }} : FAIL ]"
    success_msg: "[ {{ '{{' }} log_message {{ '}}' }} : PASS ]"
{% endif %}

# Skip HTTP accessibility testing for now - loop variable issues need resolution
- name: "[{{ _login.cluster.name |d('Cluster')}}][Route] HTTP testing skipped"
  debug:
    msg: "HTTP accessibility testing skipped due to template loop issues - routes were discovered successfully"
  when: 
    - not _r_validate_universal.failed | bool
    - _r_validate_universal.resources | default([]) | length > 0

