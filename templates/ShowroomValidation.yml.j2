---
# Showroom validation - discovers showroom* deployments and routes, validates lab content
- name: "[{{ _login.cluster.name |d('Cluster')}}][Showroom] Discovering showroom deployments cluster-wide"
  ignore_errors: true
  kubernetes.core.k8s_info:
    kind: Deployment
  register: _r_showroom_deployments
  retries: "{{ _validate.retries | default(30) }}"
  delay: "{{ _validate.delay | default(5) }}"

- name: "[{{ _login.cluster.name |d('Cluster')}}][Showroom] Discovering showroom routes cluster-wide"
  ignore_errors: true
  kubernetes.core.k8s_info:
    api_version: route.openshift.io/v1
    kind: Route
  register: _r_showroom_routes
  retries: "{{ _validate.retries | default(30) }}"
  delay: "{{ _validate.delay | default(5) }}"

- name: "Filter showroom deployments and routes"
  set_fact:
    _filtered_deployments: "{{ '{{' }} (_r_showroom_deployments.resources | default([])) if not (_r_showroom_deployments.failed | default(false)) else [] {{ '}}' }}"
    _filtered_routes: "{{ '{{' }} (_r_showroom_routes.resources | default([])) if not (_r_showroom_routes.failed | default(false)) else [] {{ '}}' }}"

- name: "Apply showroom name filter"
  set_fact:
    _filtered_deployments: "{{ '{{' }} _filtered_deployments | selectattr('metadata.name', 'match', '^showroom.*') | list {{ '}}' }}"
    _filtered_routes: "{{ '{{' }} _filtered_routes | selectattr('metadata.name', 'match', '^showroom.*') | list {{ '}}' }}"

# Debug output to see what showroom resources we found
- name: "Debug - Show showroom discovery results"
  debug:
    msg: |
      Showroom Discovery Results:
      - Deployment Query Failed: {{ '{{' }} _r_showroom_deployments.failed | default(false) {{ '}}' }}
      - Route Query Failed: {{ '{{' }} _r_showroom_routes.failed | default(false) {{ '}}' }}
      - Total Deployments: {{ '{{' }} _r_showroom_deployments.resources | default([]) | length {{ '}}' }}
      - Total Routes: {{ '{{' }} _r_showroom_routes.resources | default([]) | length {{ '}}' }}
      - Showroom Deployments: {{ '{{' }} _filtered_deployments | default([]) | length {{ '}}' }}
      - Showroom Routes: {{ '{{' }} _filtered_routes | default([]) | length {{ '}}' }}
      - Deployment Names: {{ '{{' }} _filtered_deployments | default([]) | map(attribute='metadata.name') | list {{ '}}' }}
      - Route Names: {{ '{{' }} _filtered_routes | default([]) | map(attribute='metadata.name') | list {{ '}}' }}

- name: "Test HTTP connectivity to showroom routes"
  when: 
    - _filtered_routes | default([]) | length > 0
  uri:
    url: "{{ '{{' }} (item.spec.tls is defined) | ternary('https', 'http') {{ '}}' }}://{{ '{{' }} item.spec.host {{ '}}' }}"
    method: GET
    return_content: true
    validate_certs: false
    status_code: [200, 302, 301]
    timeout: 30
  register: _r_showroom_http_tests
  ignore_errors: true
  loop: "{{ '{{' }} _filtered_routes | default([]) {{ '}}' }}"
  retries: "{{ _validate.retries | default(3) }}"
  delay: "{{ _validate.delay | default(10) }}"

- name: "Count successful HTTP responses and validate content"
  when: 
    - _r_showroom_http_tests is defined
    - _r_showroom_http_tests.results is defined
  set_fact:
    _http_success_count: "{{ '{{' }} _r_showroom_http_tests.results | selectattr('failed', 'equalto', false) | list | length {{ '}}' }}"
    _content_valid_count: "{{ '{{' }} _r_showroom_http_tests.results | selectattr('failed', 'equalto', false) | rejectattr('content', 'search', 'Directory listing for') | selectattr('content', 'search', '(?i)(workshop|lab|instruction|antora|adoc|exercise)') | list | length {{ '}}' }}"
    _failed_showrooms: "{{ '{{' }} _r_showroom_http_tests.results | selectattr('failed', 'equalto', false) | selectattr('content', 'search', 'Directory listing for') | map(attribute='item.metadata.name') | list {{ '}}' }}"

- name: "Success - showroom deployments and routes accessible (HTTP connectivity)"
  when: 
    - not _r_showroom_deployments.failed | bool
    - not _r_showroom_routes.failed | bool
    - _filtered_deployments | default([]) | length > 0
    - _filtered_routes | default([]) | length > 0
    - _http_success_count | default(0) | int == (_filtered_routes | default([]) | length)
  set_fact:
    success: true

- name: "No Success - showroom validation failed"
  when: 
    - _r_showroom_deployments.failed | bool or _r_showroom_routes.failed | bool or (_filtered_deployments | default([]) | length == 0) or (_filtered_routes | default([]) | length == 0) or (_http_success_count | default(0) | int != (_filtered_routes | default([]) | length))
  set_fact:
    success: false

- name: "Display showroom validation summary"
  debug:
    msg: |
      Showroom Validation Summary:
      - Showroom Deployments Found: {{ '{{' }} _filtered_deployments | default([]) | length {{ '}}' }}
      - Showroom Routes Found: {{ '{{' }} _filtered_routes | default([]) | length {{ '}}' }}
      {% if _r_showroom_http_tests is defined and _r_showroom_http_tests.results is defined %}
      - HTTP Tests Performed: {{ '{{' }} _r_showroom_http_tests.results | default([]) | length {{ '}}' }}
      - HTTP Successful: {{ '{{' }} _http_success_count | default(0) {{ '}}' }} / {{ '{{' }} _filtered_routes | default([]) | length {{ '}}' }}
      - Valid Lab Content: {{ '{{' }} _content_valid_count | default(0) {{ '}}' }} / {{ '{{' }} _filtered_routes | default([]) | length {{ '}}' }}
      {% if _failed_showrooms is defined and _failed_showrooms | default([]) | length > 0 %}
      - Broken Showrooms (Directory listing): {{ '{{' }} _failed_showrooms | default([]) | join(', ') {{ '}}' }}
      {% endif %}
      {% else %}
      - HTTP Tests: SKIPPED (no routes found)
      {% endif %}

- name: "set log message"
  set_fact:
    log_message: "Showroom deployments and HTTP connectivity validation in {{ _validate.namespace | default('cluster') }}"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
- name: "Showroom validation result"
  debug:
    msg: "[ {{ '{{' }} log_message {{ '}}' }} : {% if success %}PASS{% else %}FAIL{% endif %} ]"
{% else %}
- name: "Showroom validation result"
  assert:
    that: success | default(false) | bool
    fail_msg: "[ {{ '{{' }} log_message {{ '}}' }} : FAIL ]"
    success_msg: "[ {{ '{{' }} log_message {{ '}}' }} : PASS ]"
{% endif %}