---
# Intelligent Secret validation - checks existence and provides metadata (no sensitive data exposure)
- name: "[{{ _login.cluster.name |d('Cluster')}}][Secret] Checking {{ _validate.name | default('secrets') }} in {{ _validate.namespace | default('all namespaces') }}"
  ignore_errors: true
  kubernetes.core.k8s_info:
    kind: Secret
{% if _validate.name is defined %}
    name: "{{ _validate.name }}"
{% endif %}
{% if _validate.namespace is defined %}
    namespace: "{{ _validate.namespace }}"
{% endif %}
  register: _r_validate_universal
  retries: "{{ _validate.retries | default(30) }}"
  delay: "{{ _validate.delay | default(5) }}"
  until:
    - _r_validate_universal.resources | length > 0

- name: "Success - secret found"
  when: not _r_validate_universal.failed | bool
  set_fact:
    success: true

- name: "No Success - secret not found"
  when: _r_validate_universal.failed | bool
  set_fact:
    success: false

- name: "Display secret metadata (no sensitive data)"
  when: not _r_validate_universal.failed | bool
  debug:
    msg: |
      Secret Information:
      {{ '{%' }} for secret in _r_validate_universal.resources {{ '%}' }}
      - {{ '{{' }} secret.metadata.name {{ '}}' }} ({{ '{{' }} secret.metadata.namespace {{ '}}' }}):
        Type: {{ '{{' }} secret.type | default('Opaque') {{ '}}' }}
        Keys: {{ '{{' }} secret.data.keys() | list | join(', ') if secret.data else 'None' {{ '}}' }}
        Age: {{ '{{' }} secret.metadata.creationTimestamp {{ '}}' }}
        {{ '{%' }} if secret.metadata.name is search('.*gitops.*') or secret.metadata.name is search('.*argocd.*') {{ '%}' }}
        Note: GitOps/ArgoCD secret detected - admin credentials available
        {{ '{%' }} endif {{ '%}' }}
      {{ '{%' }} endfor {{ '%}' }}

# Special handling for ArgoCD admin secrets
- name: "[{{ _login.cluster.name |d('Cluster')}}][Secret] ArgoCD admin password info"
  when: 
    - not _r_validate_universal.failed | bool
    - _r_validate_universal.resources | length > 0
    - _validate.name is search('.*gitops.*') or _validate.name is search('.*argocd.*')
  debug:
    msg: |
      ArgoCD Admin Access Information:
      Secret contains admin credentials for ArgoCD access.
      Use 'oc extract secret/{{ _validate.name }} --to=-' to retrieve admin password.
      Admin username is typically 'admin'.

- name: "set log message"
  set_fact:
    log_message: "{{ _validate.name | default('Secrets') }} discovery in {{ _validate.namespace | default('cluster') }}"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
- name: "Secret validation result"
  debug:
    msg: "[ {{ '{{' }} log_message {{ '}}' }} : {% if success %}PASS{% else %}FAIL{% endif %} ]"
{% else %}
- name: "Secret validation result"
  assert:
    that: not _r_validate_universal.failed | bool
    fail_msg: "[ {{ '{{' }} log_message {{ '}}' }} : FAIL ]"
    success_msg: "[ {{ '{{' }} log_message {{ '}}' }} : PASS ]"
{% endif %}