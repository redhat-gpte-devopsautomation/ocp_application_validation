---
# GitLab Users validation - verifies users are created via GitLab API
# Required parameters: namespace, route_name, secret_name
- name: "[{{ _login.cluster.name |d('Cluster')}}][GitLabUsers] Validating GitLab users in {{ _validate.namespace }}"
  block:
    - name: "Get GitLab root password from secret"
      kubernetes.core.k8s_info:
        kind: Secret
        name: "{{ _validate.secret_name }}"
        namespace: "{{ _validate.namespace }}"
      register: _r_gitlab_secret
      ignore_errors: true

    - name: "Get GitLab route for API endpoint"
      kubernetes.core.k8s_info:
        api_version: route.openshift.io/v1
        kind: Route
        name: "{{ _validate.route_name }}"
        namespace: "{{ _validate.namespace }}"
      register: _r_gitlab_route
      ignore_errors: true

    - name: "Validate GitLab users via API"
      when: 
        - not _r_gitlab_secret.failed | default(true)
        - not _r_gitlab_route.failed | default(true)
        - _r_gitlab_secret.resources | length > 0
        - _r_gitlab_route.resources | length > 0
        - _r_gitlab_secret.resources[0].data is defined
        - _r_gitlab_secret.resources[0].data.GITLAB_ROOT_PASSWORD is defined
      uri:
        {% raw %}
        url: "{{ (_r_gitlab_route.resources[0].spec.tls is defined) | ternary('https', 'http') }}://{{ _r_gitlab_route.resources[0].spec.host }}/api/v4/users"
        {% endraw -%}
        method: GET
        headers:
          {% raw %}
          Authorization: "Bearer {{ _r_gitlab_secret.resources[0].data.GITLAB_ROOT_PASSWORD | b64decode }}"
          {% endraw -%}
        validate_certs: false
        return_content: true
        status_code: [200]
        timeout: 30
      register: _r_gitlab_users_api
      ignore_errors: true
      retries: "{{ _validate.retries | default(3) }}"
      delay: "{{ _validate.delay | default(10) }}"

    - name: "Success - GitLab users found"
      when: 
        - not _r_gitlab_users_api.failed | default(true)
        - _r_gitlab_users_api.json is defined
        - _r_gitlab_users_api.json | length > 1
      set_fact:
        success: true

    - name: "No Success - GitLab user validation failed"
      when: 
        - _r_gitlab_users_api.failed | default(true) or (_r_gitlab_users_api.json | default([]) | length <= 1)
      set_fact:
        success: false

    - name: "Get GitLab projects/repositories"
      when: 
        - not _r_gitlab_users_api.failed | default(true)
        - _r_gitlab_users_api.json is defined
        - _r_gitlab_users_api.json | length > 1
        - _r_gitlab_secret.resources | length > 0
        - _r_gitlab_secret.resources[0].data is defined
        - _r_gitlab_secret.resources[0].data.GITLAB_ROOT_PASSWORD is defined
        - _r_gitlab_route.resources | length > 0
      uri:
        {% raw %}
        url: "{{ (_r_gitlab_route.resources[0].spec.tls is defined) | ternary('https', 'http') }}://{{ _r_gitlab_route.resources[0].spec.host }}/api/v4/projects?simple=true&per_page=100"
        {% endraw -%}
        method: GET
        headers:
          {% raw %}
          Authorization: "Bearer {{ _r_gitlab_secret.resources[0].data.GITLAB_ROOT_PASSWORD | b64decode }}"
          {% endraw -%}
        validate_certs: false
        return_content: true
        status_code: [200]
        timeout: 30
      register: _r_gitlab_projects_api
      ignore_errors: true
      retries: "{{ _validate.retries | default(3) }}"
      delay: "{{ _validate.delay | default(10) }}"

    - name: "Display GitLab users and repositories validation result"
      debug:
        msg: |
          GitLab User and Repository Validation Results:
          {% if _r_gitlab_secret.failed | default(true) %}
          - Secret Access: FAILED ({{ _r_gitlab_secret.msg | default('Secret not found') }})
          {% elif _r_gitlab_route.failed | default(true) %}
          - Route Access: FAILED ({{ _r_gitlab_route.msg | default('Route not found') }})
          {% elif _r_gitlab_users_api.failed | default(true) %}
          - User API Call: FAILED ({{ _r_gitlab_users_api.msg | default('API call failed') }})
          {% else %}
          - User API Call: SUCCESS
          - Total Users: {{ _r_gitlab_users_api.json | length }}
          - Non-Root Users: {{ (_r_gitlab_users_api.json | rejectattr('username', 'equalto', 'root') | list | length) }}
          - User List: {{ _r_gitlab_users_api.json | map(attribute='username') | list | join(', ') }}
          {% if _r_gitlab_projects_api is defined and not _r_gitlab_projects_api.failed | default(true) %}
          - Projects API Call: SUCCESS
          - Total Projects: {{ _r_gitlab_projects_api.json | length }}
          - Project List: {{ _r_gitlab_projects_api.json | map(attribute='name') | list | join(', ') }}
          {% elif _r_gitlab_projects_api is defined %}
          - Projects API Call: FAILED ({{ _r_gitlab_projects_api.msg | default('Projects API failed') }})
          {% else %}
          - Projects API Call: SKIPPED (user validation failed)
          {% endif %}
          {% endif %}

    - name: "set log message"
      set_fact:
        log_message: "GitLab users validation in {{ _validate.namespace }}"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
    - name: "GitLab users validation result"
      debug:
        msg: {% raw %}"[ {{ log_message }} : {%if success%}PASS{%else%}FAIL{%endif%} ]"{% endraw %}
{% else %}
    - name: "GitLab users validation result"
      assert:
        that: success | default(false) | bool
        {% raw %}
        fail_msg: "[ {{ log_message }} : FAIL ]"
        success_msg: "[ {{ log_message }} : PASS ]"
        {% endraw %}
{% endif %}