---
# Intelligent Deployment validation - checks existence, ready replicas, and pod health
- name: "[{{ _login.cluster.name |d('Cluster')}}][Deployment] Checking {{ _validate.name | default('deployments') }} in {{ _validate.namespace | default('all namespaces') }}"
  ignore_errors: true
  kubernetes.core.k8s_info:
    kind: Deployment
    name: "{{ _validate.name | default(omit) }}"
    namespace: "{{ _validate.namespace | default(omit) }}"
  register: _r_validate_universal
  retries: "{{ _validate.retries | default(60) }}"
  delay: "{{ _validate.delay | default(15) }}"
  until:
    - _r_validate_universal.resources | length > 0
    # All deployments should have at least 1 ready replica
    - _r_validate_universal.resources | selectattr('status.readyReplicas', 'defined') | selectattr('status.readyReplicas', 'greaterthan', 0) | list | length == (_r_validate_universal.resources | length)

- name: "Success - deployment ready"
  when: not _r_validate_universal.failed | bool
  set_fact:
    success: true

- name: "No Success - deployment not ready"
  when: _r_validate_universal.failed | bool
  set_fact:
    success: false

- name: "Display deployment status"
  when: not _r_validate_universal.failed | bool
  debug:
    msg: |
      Deployment Status:
      {{ '{%' }} for deploy in _r_validate_universal.resources {{ '%}' }}
      - {{ '{{' }} deploy.metadata.name {{ '}}' }} ({{ '{{' }} deploy.metadata.namespace {{ '}}' }}):
        Replicas: {{ '{{' }} deploy.status.replicas | default(0) {{ '}}' }}
        Ready: {{ '{{' }} deploy.status.readyReplicas | default(0) {{ '}}' }}
        Available: {{ '{{' }} deploy.status.availableReplicas | default(0) {{ '}}' }}
        Status: {{ '{%' }} if deploy.status.readyReplicas | default(0) > 0 {{ '%}' }}Ready{{ '{%' }} else {{ '%}' }}Not Ready{{ '{%' }} endif {{ '%}' }}
      {{ '{%' }} endfor {{ '%}' }}

- name: "set log message"
  set_fact:
    log_message: "{{ _validate.name | default('Deployments') }} deployment and pod health validation in {{ _validate.namespace | default('cluster') }}"

{{ '{%' }} if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" {{ '%}' }}
- name: "Deployment validation result"
  debug:
    msg: "[ {{ '{{' }} log_message {{ '}}' }} : {{ '{%' }} if success {{ '%}' }}PASS{{ '{%' }} else {{ '%}' }}FAIL{{ '{%' }} endif {{ '%}' }} ]"
{{ '{%' }} else {{ '%}' }}
- name: "Deployment validation result"
  assert:
    that: not _r_validate_universal.failed | bool
    fail_msg: "[ {{ '{{' }} log_message {{ '}}' }} : FAIL ]"
    success_msg: "[ {{ '{{' }} log_message {{ '}}' }} : PASS ]"
{{ '{%' }} endif {{ '%}' }}