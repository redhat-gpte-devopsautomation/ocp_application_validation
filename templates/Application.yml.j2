---
# Intelligent ArgoCD Application validation - checks existence, sync status, and health
- name: "[{{ _login.cluster.name |d('Cluster')}}][ArgoCD] Waiting for applications to sync in {{ _validate.namespace | default('openshift-gitops') }}"
  ignore_errors: true
  kubernetes.core.k8s_info:
    api_version: argoproj.io/v1alpha1
    kind: Application
{% if _validate.name is defined %}
    name: "{{ _validate.name }}"
{% endif %}
    namespace: "{{ _validate.namespace | default('openshift-gitops') }}"
  register: _r_validate_universal
  retries: "{{ _validate.sync_timeout | default(60) }}"
  delay: "{{ _validate.delay | default(15) }}"
  until:
    - _r_validate_universal is defined
    - not _r_validate_universal.failed | default(true)
    # Either no apps exist (which is OK) OR apps exist and are all synced+healthy
    - (_r_validate_universal.resources | default([]) | length == 0) or 
      ((_r_validate_universal.resources | default([]) | length > 0) and
       (_r_validate_universal.resources | default([]) | selectattr('status.sync.status', 'defined') | selectattr('status.sync.status', 'equalto', 'Synced') | list | length == (_r_validate_universal.resources | default([]) | length)) and
       (_r_validate_universal.resources | default([]) | selectattr('status.health.status', 'defined') | selectattr('status.health.status', 'equalto', 'Healthy') | list | length == (_r_validate_universal.resources | default([]) | length)))

- name: "Success - applications discovered"
  when: 
    - not _r_validate_universal.failed | default(true) | bool
    - _r_validate_universal.resources | default([]) | length > 0
  set_fact:
    success: true

- name: "Info - no applications found (might be expected)"
  when: 
    - not _r_validate_universal.failed | default(true) | bool
    - _r_validate_universal.resources | default([]) | length == 0
  set_fact:
    success: true

- name: "No Success - application discovery failed"
  when: _r_validate_universal.failed | default(true) | bool
  set_fact:
    success: false

- name: "set log message"
  set_fact:
    log_message: "ArgoCD applications sync and health validation in {{ _validate.namespace | default('openshift-gitops') }}"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
- name: "ArgoCD applications discovery result"
  debug:
    msg: "[ {{ '{{' }} log_message {{ '}}' }} : {{ '{%' }} if success {{ '%}' }}PASS - Found {{ '{{' }} _r_validate_universal.resources | default([]) | length {{ '}}' }} applications{{ '{%' }} else {{ '%}' }}FAIL{{ '{%' }} endif {{ '%}' }} ]"
{% else %}
- name: "ArgoCD applications discovery result"
  assert:
    that: not _r_validate_universal.failed | default(true) | bool
    fail_msg: "[ {{ '{{' }} log_message {{ '}}' }} : FAIL ]"
    success_msg: "[ {{ '{{' }} log_message {{ '}}' }} : PASS - Found {{ '{{' }} _r_validate_universal.resources | default([]) | length {{ '}}' }} applications ]"
{% endif %}

# Check sync status and health of discovered applications
- name: "[{{ _login.cluster.name |d('Cluster')}}][ArgoCD] Checking application sync status and health"
  when: 
    - not _r_validate_universal.failed | default(true) | bool
    - _r_validate_universal.resources | default([]) | length > 0
  block:
    - name: "Display application status summary"
      debug:
        msg: |
          ArgoCD Applications Status:
          Total: {{ '{{' }} _r_validate_universal.resources | default([]) | length {{ '}}' }}
          Synced: {{ '{{' }} _r_validate_universal.resources | default([]) | selectattr('status.sync.status', 'defined') | selectattr('status.sync.status', 'equalto', 'Synced') | list | length {{ '}}' }}
          Healthy: {{ '{{' }} _r_validate_universal.resources | default([]) | selectattr('status.health.status', 'defined') | selectattr('status.health.status', 'equalto', 'Healthy') | list | length {{ '}}' }}
          
          Applications:
          {{ '{%' }} for app in _r_validate_universal.resources | default([]) {{ '%}' }}
          - {{ '{{' }} app.metadata.name {{ '}}' }}: 
            Sync: {{ '{{' }} app.status.sync.status | default('Unknown') {{ '}}' }}
            Health: {{ '{{' }} app.status.health.status | default('Unknown') {{ '}}' }}
          {{ '{%' }} endfor {{ '%}' }}

    # Auto-discover resources from ArgoCD applications
    - name: "Discover resources from ArgoCD applications"
      when: _validate.auto_discover | default(true) | bool
      block:
        - name: "Extract target resources from applications"
          set_fact:
            _discovered_resources: "{{ '{{' }} _discovered_resources | default([]) + [
              {
                'app_name': app.metadata.name,
                'namespace': app.spec.destination.namespace | default(app.metadata.namespace),
                'kind': 'Deployment',
                'name': app.metadata.name,
                'source': 'argocd-app'
              },
              {
                'app_name': app.metadata.name,
                'namespace': app.spec.destination.namespace | default(app.metadata.namespace),
                'kind': 'Service', 
                'name': app.metadata.name,
                'source': 'argocd-app'
              },
              {
                'app_name': app.metadata.name,
                'namespace': app.spec.destination.namespace | default(app.metadata.namespace),
                'kind': 'Route',
                'name': app.metadata.name,
                'source': 'argocd-app'
              }
            ] {{ '}}' }}"
          loop: "{{ '{{' }} _r_validate_universal.resources | default([]) {{ '}}' }}"
          loop_control:
            loop_var: app

        - name: "Display discovered resources for validation"
          debug:
            msg: |
              Auto-discovered resources from ArgoCD applications:
              {{ '{%' }} for resource in _discovered_resources | default([]) {{ '%}' }}
              - {{ '{{' }} resource.kind {{ '}}' }}/{{ '{{' }} resource.name {{ '}}' }} in {{ '{{' }} resource.namespace {{ '}}' }} (from app: {{ '{{' }} resource.app_name {{ '}}' }})
              {{ '{%' }} endfor {{ '%}' }}

        - name: "Validate discovered Deployments"
          include_tasks: "{{ '{{' }} role_path {{ '}}' }}/templates/Deployment.yml.j2"
          vars:
            _validate:
              kind: Deployment
              name: "{{ '{{' }} item.name {{ '}}' }}"
              namespace: "{{ '{{' }} item.namespace {{ '}}' }}"
              retries: 10
              delay: 5
          loop: "{{ '{{' }} _discovered_resources | default([]) | selectattr('kind', 'equalto', 'Deployment') | list {{ '}}' }}"
          ignore_errors: true

        - name: "Validate discovered Routes"
          include_tasks: "{{ '{{' }} role_path {{ '}}' }}/templates/Route.yml.j2"
          vars:
            _validate:
              kind: Route
              name: "{{ '{{' }} item.name {{ '}}' }}"
              namespace: "{{ '{{' }} item.namespace {{ '}}' }}"
              retries: 5
              delay: 5
          loop: "{{ '{{' }} _discovered_resources | default([]) | selectattr('kind', 'equalto', 'Route') | list {{ '}}' }}"
          ignore_errors: true

    - name: "Success - all applications synced and healthy"
      when: 
        - (_r_validate_universal.resources | default([]) | selectattr('status.sync.status', 'defined') | selectattr('status.sync.status', 'equalto', 'Synced') | list | length) == (_r_validate_universal.resources | default([]) | length)
        - (_r_validate_universal.resources | default([]) | selectattr('status.health.status', 'defined') | selectattr('status.health.status', 'equalto', 'Healthy') | list | length) == (_r_validate_universal.resources | default([]) | length)
      set_fact:
        success: true

    - name: "Warning - some applications found but not all synced/healthy"
      when: 
        - (_r_validate_universal.resources | default([]) | selectattr('status.sync.status', 'defined') | selectattr('status.sync.status', 'equalto', 'Synced') | list | length) != (_r_validate_universal.resources | default([]) | length) or (_r_validate_universal.resources | default([]) | selectattr('status.health.status', 'defined') | selectattr('status.health.status', 'equalto', 'Healthy') | list | length) != (_r_validate_universal.resources | default([]) | length)
        - (_r_validate_universal.resources | default([]) | selectattr('status.sync.status', 'defined') | selectattr('status.sync.status', 'equalto', 'Synced') | list | length) > 0 or (_r_validate_universal.resources | default([]) | selectattr('status.health.status', 'defined') | selectattr('status.health.status', 'equalto', 'Healthy') | list | length) > 0
      set_fact:
        success: true

    - name: "No Success - no applications healthy"
      when: 
        - (_r_validate_universal.resources | default([]) | selectattr('status.sync.status', 'defined') | selectattr('status.sync.status', 'equalto', 'Synced') | list | length) == 0
        - (_r_validate_universal.resources | default([]) | selectattr('status.health.status', 'defined') | selectattr('status.health.status', 'equalto', 'Healthy') | list | length) == 0
      set_fact:
        success: false

    - name: "set log message"
      set_fact:
        log_message: "ArgoCD applications sync/health status ({{ '{{' }} _r_validate_universal.resources | default([]) | selectattr('status.sync.status', 'defined') | selectattr('status.sync.status', 'equalto', 'Synced') | list | length {{ '}}' }}/{{ '{{' }} _r_validate_universal.resources | default([]) | length {{ '}}' }} synced, {{ '{{' }} _r_validate_universal.resources | default([]) | selectattr('status.health.status', 'defined') | selectattr('status.health.status', 'equalto', 'Healthy') | list | length {{ '}}' }}/{{ '{{' }} _r_validate_universal.resources | default([]) | length {{ '}}' }} healthy)"

{% if _login.cluster.onfail | default('fail') == "ignore" or _validate.onfail | default('fail') == "ignore" %}
    - name: "ArgoCD applications status result"
      debug:
        msg: "[ {{ '{{' }} log_message {{ '}}' }} : {{ '{%' }} if success {{ '%}' }}PASS{{ '{%' }} else {{ '%}' }}FAIL{{ '{%' }} endif {{ '%}' }} ]"
{% else %}
    - name: "ArgoCD applications status result"
      assert:
        that: success | default(false) | bool
        fail_msg: "[ {{ '{{' }} log_message {{ '}}' }} : FAIL ]"
        success_msg: "[ {{ '{{' }} log_message {{ '}}' }} : PASS ]"
{% endif %}